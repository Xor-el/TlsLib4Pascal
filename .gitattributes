# Keep the test vectors out of `git archive` source exports.
/TlsLib.Tests/Data/** export-ignore
/TlsLib.Tests/Data export-ignore

# Pascal sources are CRLF everywhere (house convention), independent of any
# contributor's core.autocrlf setting, so the working tree stops showing
# spurious whole-file diffs.
*.pas text eol=crlf
*.inc text eol=crlf
*.dpr text eol=crlf
*.lpr text eol=crlf

# CI scripts and their helpers run on POSIX runners: pin them to LF so a
# checkout under core.autocrlf=true cannot hand bash a CRLF-tainted script.
*.sh  text eol=lf
*.py  text eol=lf
*.c   text eol=lf
*.env text eol=lf
*.yml text eol=lf
*.json text eol=lf
/.github/workflows/ci/fpc-tarball-sha256.txt text eol=lf
