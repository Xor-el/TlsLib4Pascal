<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="TlsLib.Net"/>
    <Type Value="RunTimeOnly"/>
    <Author Value="Xor-el (Ugochukwu Mmaduekwe)"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <OtherUnitFiles Value="..\..\src"/>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <CodeGeneration>
        <Optimizations>
          <OptimizationLevel Value="4"/>
        </Optimizations>
      </CodeGeneration>
    </CompilerOptions>
    <Description Value="Optional TCP sockets, HTTP fetcher and SVCB ECH lookup for TlsLib4Pascal"/>
    <License Value="MIT License"/>
    <Version Major="1" Minor="1"/>
    <Files Count="7">
      <Item1>
        <Filename Value="..\..\src\TlpNetExceptions.pas"/>
        <UnitName Value="TlpNetExceptions"/>
      </Item1>
      <Item2>
        <Filename Value="..\..\src\TlpINetSocket.pas"/>
        <UnitName Value="TlpINetSocket"/>
      </Item2>
      <Item3>
        <Filename Value="..\..\src\TlpPosixNetOs.pas"/>
        <UnitName Value="TlpPosixNetOs"/>
      </Item3>
      <Item4>
        <Filename Value="..\..\src\TlpWindowsNetOs.pas"/>
        <UnitName Value="TlpWindowsNetOs"/>
      </Item4>
      <Item5>
        <Filename Value="..\..\src\TlpNetSocket.pas"/>
        <UnitName Value="TlpNetSocket"/>
      </Item5>
      <Item6>
        <Filename Value="..\..\src\TlpSocketHttpFetcher.pas"/>
        <UnitName Value="TlpSocketHttpFetcher"/>
      </Item6>
      <Item7>
        <Filename Value="..\..\src\TlpEchConfigFromSvcb.pas"/>
        <UnitName Value="TlpEchConfigFromSvcb"/>
      </Item7>
    </Files>
    <RequiredPkgs Count="2">
      <Item1>
        <PackageName Value="TlsLib4PascalPackage"/>
        <MinVersion Major="1" Valid="True"/>
      </Item1>
      <Item2>
        <PackageName Value="FCL"/>
      </Item2>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
