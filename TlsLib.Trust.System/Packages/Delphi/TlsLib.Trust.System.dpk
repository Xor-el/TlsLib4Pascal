package TlsLib.Trust.System;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE RELEASE}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Optional OS system-trust sources (anchors + delegate) for TlsLib4Pascal'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  TlsLib4PascalPackage;

contains
  TlpSystemTrustExceptions in '..\..\src\TlpSystemTrustExceptions.pas',
  TlpSystemTrustBase in '..\..\src\TlpSystemTrustBase.pas',
  TlpOSLiveRevocation in '..\..\src\TlpOSLiveRevocation.pas',
  TlpFileSystemTrust in '..\..\src\TlpFileSystemTrust.pas',
  TlpPosixDynLib in '..\..\src\TlpPosixDynLib.pas',
  TlpUnixSystemTrust in '..\..\src\TlpUnixSystemTrust.pas',
  TlpWindowsSystemTrust in '..\..\src\TlpWindowsSystemTrust.pas',
  TlpAppleSystemTrust in '..\..\src\TlpAppleSystemTrust.pas',
  TlpAndroidSystemTrust in '..\..\src\TlpAndroidSystemTrust.pas',
  TlpOSSystemTrust in '..\..\src\TlpOSSystemTrust.pas',
  TlpSystemTrustFacade in '..\..\src\TlpSystemTrustFacade.pas';

end.
