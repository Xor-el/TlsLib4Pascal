      <CodeGeneration>
        <Optimizations>
          <OptimizationLevel Value="4"/>
        </Optimizations>
      </CodeGeneration>
    </CompilerOptions>
    <Description Value="Optional FIPS 140-3 / CNSA policy over the OS crypto module for TlsLib4Pascal"/>
