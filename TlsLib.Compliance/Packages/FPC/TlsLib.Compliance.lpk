        <Filename Value="..\..\src\TlpComplianceExceptions.pas"/>
        <UnitName Value="TlpComplianceExceptions"/>
      </Item2>
      <Item3>
        <Filename Value="..\..\src\TlpIModuleAttestation.pas"/>
        <UnitName Value="TlpIModuleAttestation"/>
      </Item3>
      <Item4>
        <Filename Value="..\..\src\TlpIComplianceReport.pas"/>
        <UnitName Value="TlpIComplianceReport"/>
      </Item4>
      <Item5>
        <Filename Value="..\..\src\TlpCompliancePresets.pas"/>
        <UnitName Value="TlpCompliancePresets"/>
      </Item5>
      <Item6>
        <Filename Value="..\..\src\TlpComplianceReport.pas"/>
        <UnitName Value="TlpComplianceReport"/>
      </Item6>
      <Item7>
