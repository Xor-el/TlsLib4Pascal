package TlsLib.Compliance;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE RELEASE}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Optional FIPS / CNSA policy over the OS crypto module for TlsLib4Pascal'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  TlsLib4PascalPackage,
  TlsLib.Crypto.System,
  TlsLib.Trust.System;

contains
  TlpComplianceTypes in '..\..\src\TlpComplianceTypes.pas',
  TlpComplianceExceptions in '..\..\src\TlpComplianceExceptions.pas',
  TlpIModuleAttestation in '..\..\src\TlpIModuleAttestation.pas',
  TlpIComplianceReport in '..\..\src\TlpIComplianceReport.pas',
  TlpCompliancePresets in '..\..\src\TlpCompliancePresets.pas',
  TlpComplianceReport in '..\..\src\TlpComplianceReport.pas',
  TlpComplianceHpke in '..\..\src\TlpComplianceHpke.pas',
  TlpComplianceCryptoProvider in '..\..\src\TlpComplianceCryptoProvider.pas',
  TlpCompliancePkixProvider in '..\..\src\TlpCompliancePkixProvider.pas',
  TlpWindowsModuleDecision in '..\..\src\TlpWindowsModuleDecision.pas',
  TlpWindowsModuleAttestation in '..\..\src\TlpWindowsModuleAttestation.pas',
  TlpUnattestedModule in '..\..\src\TlpUnattestedModule.pas',
  TlpOSModuleAttestation in '..\..\src\TlpOSModuleAttestation.pas',
  TlpICompliancePolicy in '..\..\src\TlpICompliancePolicy.pas',
  TlpIComplianceCredentialResolver in '..\..\src\TlpIComplianceCredentialResolver.pas',
  TlpComplianceCredentialResolver in '..\..\src\TlpComplianceCredentialResolver.pas',
  TlpIComplianceTicketKeys in '..\..\src\TlpIComplianceTicketKeys.pas',
  TlpComplianceTicketKeys in '..\..\src\TlpComplianceTicketKeys.pas',
  TlpCompliancePolicy in '..\..\src\TlpCompliancePolicy.pas',
  TlpComplianceTls in '..\..\src\TlpComplianceTls.pas';

end.
